{
  "name": "model-sync-workbench",
  "version": "0.1.1",
  "author": "罗生门",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "本地 3D 模型跨平台同步工作台",
  "scripts": {
    "start": "electron .",
    "dev": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "setup-desktop": "node node_modules/electron/install.js",
    "pack:exe": "electron-builder --win portable --x64 --publish never",
    "test:exe": "node scripts/smoke-exe.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22"
  }
}
